.DS_Store

# Secrets and local runtime state — only root .env is used
.env
.env.*
!.env.example
secrets.conf
*.log

# Local captures, generated analysis, and private purchase records
diagnostics/audio-captures/
hardware/purchases/
hardware/kicad/KiCad-backups/
output/
tmp/
software/ai-pendant-simulator/local-agent/memory/*.json

# KiCad local UI state and automatic backups
*.kicad_prl
*.lck
*-backups/
*-bak

# JavaScript
node_modules/
dist/
dist-ssr/
.next/
.vinext/
.svelte-kit/
.wrangler/
.vercel/
coverage/
*.tsbuildinfo

# Rust
target/
**/target/

# Zephyr / Nordic
build/
build-*/
# West workspace state and the west-managed libopus checkout; the pin
# lives in firmware/nrf9160/west.yml (west init -l firmware/nrf9160 && west update)
firmware/.west/
firmware/nrf9160/third_party/opus/

# PlatformIO / Python
.pio/
.venv/
__pycache__/
*.pyc

# Editors
.idea/
.vscode/
*.swp
*~

# Harness per-agent round locks: process-local, never shared.
diagnostics/harness-derivation/*.lock
software/ai-pendant-simulator/local-agent/memory/*.bak

# Xcode per-user IDE state. Never shared, and in a tree where several agents
# commit concurrently it is exactly the kind of file a stray sweep picks up.
xcuserdata/
*.xcuserdatad/
