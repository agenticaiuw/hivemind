# =============================================================================
# AI Pendant — the ONLY env file (repo root .env)
# =============================================================================
# cp .env.example .env  then fill in values.

PAIRING_CODE=replace-with-a-random-code
# The ADMIN relay credential: principal kind 'admin', scopes ['*']. It reaches
# /v1/ops/*, the routine scheduler and every device's data. Owner-operated
# tooling only (scripts/pendant-credentials.mjs list|revoke). Clients should
# each hold their own scoped device token instead — see RELAY_DEVICE_TOKEN.
RELAY_API_KEY=replace-with-a-random-relay-key
AGENT_TOKEN=replace-with-a-random-agent-token
OPENAI_API_KEY=sk-...
RELAY_URL=https://your-relay.workers.dev
SESSION_SECRET=replace-with-a-long-random-secret

# The Mac bridge's OWN credential (role mac_bridge), minted once with:
#   node software/ai-pendant-simulator/scripts/pendant-credentials.mjs \
#     pair --device-id home-macbook-bridge --role mac_bridge
# It can claim work, post results, heartbeat itself, write fleet state and sync
# product state — and nothing else. Unset means the bridge falls back to
# RELAY_API_KEY and says so once at startup. Prefer RELAY_DEVICE_TOKEN_FILE
# (default ~/.config/ai-pendant/mac-bridge-token) to keep it out of the process
# environment that spawned tools inherit.
# RELAY_DEVICE_TOKEN=pdt_...
# RELAY_DEVICE_TOKEN_FILE=/Users/you/.config/ai-pendant/mac-bridge-token

# Optional
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# OPENAI_AUDIO_MODEL=gpt-audio-1.5
# LLM_MODEL=gpt-5.6-luna
# LLM_VISION_MODEL=gpt-4.1-mini
# OPENAI_API_BASE_URL=https://api.openai.com/v1
