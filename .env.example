# =============================================================================
# AI Pendant — the ONLY env file (repo root .env)
# =============================================================================
# cp .env.example .env  then fill in values. Three variables is the whole
# contract; everything else is derived, defaulted, or minted per device.

# The one owner-minted secret. The env loaders (local-agent/loadEnv.js,
# software/load-pendant-env.mjs) derive AGENT_TOKEN and SESSION_SECRET from it
# as labelled HMACs, the dashboard login key is this same value, and the
# browser extension's one-paste pairing spends it once to obtain both of its
# credentials (Settings → Pair this browser). Rotating this line rotates
# everything derived from it. An explicit AGENT_TOKEN= or SESSION_SECRET= line
# still wins over the derivation — that is the escape hatch, not the norm.
PAIRING_CODE=replace-with-a-long-random-code

# The ADMIN relay credential: principal kind 'admin', scopes ['*']. It reaches
# /v1/ops/*, the routine scheduler and every device's data. Owner-operated
# tooling only (scripts/pendant-credentials.mjs list|revoke). Clients each
# hold their own scoped device token instead. Not derivable here: the deployed
# worker holds its own copy, and rotating that is a wrangler-secret change.
RELAY_API_KEY=replace-with-a-random-relay-key

# Third-party. Not ours to derive.
OPENAI_API_KEY=sk-...

# -----------------------------------------------------------------------------
# Defaults you can override, none required:
# RELAY_URL=http://localhost:8787          # local relay dev; defaults to the
#                                          # deployed worker otherwise
# PENDANT_COMPUTER_USE_ENABLED=0           # default on; 0 turns it off
# PENDANT_VISION_UPLOAD_CONSENT=0          # default on; 0 withdraws it
# NRF_CLOUD_API_KEY=...                    # only for manual nRF Cloud tooling;
#                                          # nothing in this repo reads it

# The Mac bridge's OWN credential (role mac_bridge), minted once with:
#   node software/ai-pendant-simulator/scripts/pendant-credentials.mjs \
#     pair --device-id home-macbook-bridge --role mac_bridge
# Unset means the bridge falls back to RELAY_API_KEY and says so once at
# startup. Prefer RELAY_DEVICE_TOKEN_FILE (default
# ~/.config/ai-pendant/mac-bridge-token) to keep it out of the process
# environment that spawned tools inherit.
# RELAY_DEVICE_TOKEN=pdt_...
# RELAY_DEVICE_TOKEN_FILE=/Users/you/.config/ai-pendant/mac-bridge-token

# Optional model overrides
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# OPENAI_AUDIO_MODEL=gpt-audio-1.5
# LLM_MODEL=gpt-5.6-luna
# LLM_VISION_MODEL=gpt-4.1-mini
# OPENAI_API_BASE_URL=https://api.openai.com/v1
