#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>
#include <samples/cellular/nrf91_crypto_partitions.dtsi>

/*
 * Breadboard hardware controls (owner's 2026-08-12 parts order).
 *
 * All buttons and the encoder switch to GND and rely on the internal
 * pull-ups declared here, so a wire that falls off the breadboard reads
 * "not pressed" instead of chattering. The mic-power sense is the one
 * deliberate exception: it watches the SPH0645's VDD net through 100k,
 * so it must not fight that net with any pull at all — high means the
 * red latching switch is feeding the mic, low means the owner cut its
 * power (the only honest hardware mute a digital mic has).
 */
/ {
	pendant_controls {
		compatible = "gpio-keys";

		ask_button: ask_button {
			gpios = <&gpio0 21 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		};
		memo_button: memo_button {
			gpios = <&gpio0 22 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		};
		approve_button: approve_button {
			gpios = <&gpio0 23 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		};
		encoder_a: encoder_a {
			gpios = <&gpio0 24 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		};
		encoder_b: encoder_b {
			gpios = <&gpio0 25 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		};
		encoder_push: encoder_push {
			gpios = <&gpio0 28 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		};
		mic_power_sense: mic_power_sense {
			gpios = <&gpio0 26 GPIO_ACTIVE_HIGH>;
		};
		/*
		 * LSM6DSOX INT1 (double-tap wake). The IMU drives this push-pull
		 * active-high; the internal pull-down only defines the level when
		 * the breadboard wire falls out, so a missing wire reads "no tap"
		 * forever instead of floating into phantom conversations.
		 */
		accel_int1: accel_int1 {
			gpios = <&gpio0 27 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
		};
	};

	/*
	 * Output-only pins share the gpio-leds shape (plain DT gpios consumed
	 * through GPIO_DT_SPEC_GET; no LED driver is enabled, so no code cost).
	 *
	 * amp_sd_mode gates the MAX98357A speaker amp: driven HIGH the amp
	 * plays the LEFT I2S slot (SD_MODE > 1.4 V = left channel, datasheet
	 * Table 5), which is the only slot this firmware ever puts audio in;
	 * driven LOW the amp is in full shutdown (0.6 uA). Boot default is
	 * LOW — Bluetooth through the ESP32 stays the sink until an
	 * {"type":"audio_sink"} control frame says otherwise.
	 *
	 * P0.01 because it is the last direction-safe free pin: it is the
	 * nRF91-TX line of the (disabled) uart1/VCOM2 group, so the DK's
	 * interface MCU only ever LISTENS on it. P0.00 (the group's RX) is
	 * driven by the interface MCU and P0.15 is the volume pot's ADC
	 * input (the only free AIN — see &adc below). Someone opening VCOM2
	 * on the host sees sink toggles as stray bytes; nothing more.
	 */
	pendant_outputs {
		compatible = "gpio-leds";

		amp_sd_mode: amp_sd_mode {
			gpios = <&gpio0 1 GPIO_ACTIVE_HIGH>;
		};
	};

	aliases {
		ask-btn = &ask_button;
		memo-btn = &memo_button;
		approve-btn = &approve_button;
		encoder-a = &encoder_a;
		encoder-b = &encoder_b;
		encoder-push = &encoder_push;
		mic-sense = &mic_power_sense;
		accel-int1 = &accel_int1;
		amp-sd-mode = &amp_sd_mode;
	};
};

/*
 * Edge interrupts for the new controls ride the GPIO SENSE mechanism
 * (PORT event) instead of GPIOTE channels: the nRF9160 has only 8 GPIOTE
 * channels and the DK's own buttons already use some. Encoder edges are
 * hand-speed (worst observed ~2.5 ms apart on a fast spin) — µs-class
 * PORT latency is irrelevant there. Bits: P0.21-25, P0.27 (accelerometer
 * INT1 — a double-tap is even slower than a hand on a knob) and P0.28.
 */
&gpio0 {
	sense-edge-mask = <0x1be00000>;
};

/*
 * Console goes TX-only on its board-default pin (P0.29 -> DK VCOM0).
 *
 * The board's uart0_default pinctrl also claimed P0.26 (CTS, with a
 * bias-pull-up — directly against the mic-sense contract above, which
 * requires NO pull on that net), P0.27 (RTS — now the accelerometer's
 * INT1) and P0.28 (RX — the encoder push button). Nothing ever used
 * them: flow control was never enabled and console input is not a thing
 * this firmware has. Dropping them from the pinctrl frees all three
 * pins honestly instead of leaning on "the UARTE probably won't drive
 * them".
 */
&pinctrl {
	uart0_console_txonly: uart0_console_txonly {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 29)>;
		};
	};

	uart0_sleep_txonly: uart0_sleep_txonly {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 29)>;
			low-power-enable;
		};
	};
};

&uart0 {
	pinctrl-0 = <&uart0_console_txonly>;
	pinctrl-1 = <&uart0_sleep_txonly>;
	disable-rx;
};

/*
 * SRAM partitions — same node structure as Nordic's
 * nrf91_sram_crypto_partitions.dtsi but sized for THIS build: that dtsi
 * reserves 88 kB of secure RAM for the full TF-M crypto profile, while
 * this firmware runs TFM_PROFILE_TYPE_MINIMAL (32 kB). The 56 kB
 * difference funds the full-duplex audio buffers (concurrent Opus
 * encoder + decoder + jitter ring).
 *
 *   0x2000_0000  Secure RAM (TF-M minimal)       (   32 kB)
 *   0x2000_8000  Non-secure RAM area             (  224 kB)
 *     0x2000_8000  Modem shared area             ( 17768 B)
 *       0x2000_8000  control                     (  1256 B)
 *       0x2000_84e8  app -> cell                 (  8320 B)
 *       0x2000_a568  cell -> app                 (    8 kB)
 *     0x2000_c568  Application RAM               (211608 B)
 */
/delete-node/ &sram0_s;
/delete-node/ &sram0_ns;

&sram0 {
	sram0_s: sram@0 {
		reg = <0x0 0x8000>;
	};

	sram0_ns: sram@8000 {
		reg = <0x8000 0x38000>;
		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0x0 0x8000 0x38000>;

		/* Must be in first 128 kB of RAM. */
		sram0_ns_modem: sram0_ns@0 {
			/* Modem (shared) memory */
			reg = <0x0 0x4568>;
			#address-cells = <1>;
			#size-cells = <1>;
			ranges = <0x0 0x0 0x4568>;

			cpuapp_cpucell_ipc_shm_ctrl: sram0_ns_modem@0 {
				/* Modem IPC control */
				reg = <0x0 0x4e8>;
			};

			cpuapp_cpucell_ipc_shm_heap: sram0_ns_modem@4e8 {
				/* Modem IPC transmit */
				reg = <0x4e8 0x2080>;
			};

			cpucell_cpuapp_ipc_shm_heap: sram0_ns_modem@2568 {
				/* Modem IPC receive */
				reg = <0x2568 0x2000>;
			};
		};

		sram0_ns_app: sram0_ns@4568 {
			/* Non-Secure application memory */
			reg = <0x4568 0x33a98>;
		};
	};
};

&pinctrl {
	/*
	 * Agent-response audio to the ESP32 Bluetooth bridge:
	 *   LRC  -> A3 / P0.17 -> ESP32 GPIO33
	 *   BCLK -> A4 / P0.18 -> ESP32 GPIO27
	 *   DATA -> A5 / P0.19 -> ESP32 GPIO14
	 *
	 * Unlike the former A0/A1 pins, P0.17/P0.18/P0.19 are routed directly
	 * to the Arduino header and are not shared with the DK's VCOM2 path.
	 */
	/*
	 * The Adafruit SPH0645LM4H I2S microphone shares this bus:
	 *   DOUT -> dedicated GPIO header / P0.20 (I2S SDIN)
	 *
	 * During recording the nRF9160 runs I2S in slave mode: the SPH0645
	 * requires exactly 64 BCLK per stereo frame, which this I2S
	 * peripheral cannot generate as master (24-bit max word = 48 BCLK).
	 * PWM1/PWM2 generate BCLK on P0.16 (A2) and LRCLK on P0.14 (A0);
	 * two breadboard jumpers feed them back into P0.18 and P0.17.
	 * During playback the peripheral is master and drives the same pins.
	 */
	/*
	 * SDIN sits in its own group so it can carry a pull-down: with the
	 * red latching switch cutting the SPH0645's power, its DOUT floats,
	 * and an undriven SDIN would feed the capture path random full-scale
	 * garbage. The ~13k internal pull-down turns a depowered mic into
	 * digital silence. While the mic IS powered it drives DOUT only in
	 * the left slot and tri-states the rest of the frame — the pull-down
	 * resolves those tri-stated cycles to 0, exactly as before.
	 */
	i2s0_default_agent_audio: i2s0_default_agent_audio {
		group1 {
			psels = <NRF_PSEL(I2S_LRCK_M, 0, 17)>,
				<NRF_PSEL(I2S_SCK_M, 0, 18)>,
				<NRF_PSEL(I2S_SDOUT, 0, 19)>;
		};
		group2 {
			psels = <NRF_PSEL(I2S_SDIN, 0, 20)>;
			bias-pull-down;
		};
	};

	i2s0_sleep_agent_audio: i2s0_sleep_agent_audio {
		group1 {
			psels = <NRF_PSEL(I2S_LRCK_M, 0, 17)>,
				<NRF_PSEL(I2S_SCK_M, 0, 18)>,
				<NRF_PSEL(I2S_SDOUT, 0, 19)>;
			low-power-enable;
		};
		group2 {
			psels = <NRF_PSEL(I2S_SDIN, 0, 20)>;
			bias-pull-down;
			low-power-enable;
		};
	};
};

/*
 * One I2S peripheral serves both audio directions, never at the same time:
 * slave RX from the SPH0645 microphone while recording, master TX to the
 * ESP32 Bluetooth bridge while playing the agent reply.
 */
&i2s0 {
	status = "okay";
	pinctrl-0 = <&i2s0_default_agent_audio>;
	pinctrl-1 = <&i2s0_sleep_agent_audio>;
	pinctrl-names = "default", "sleep";
	clock-source = "PCLK32M";
	/*
	 * Priority 0, above NRF_DEFAULT_IRQ_PRIORITY (1). The modem's IPC
	 * IRQ and RTC1 also sit at 1, so at the default the I2S ISR could
	 * never preempt modem processing — and missing the I2S buffer
	 * deadline by one block period kills the whole duplex transfer.
	 * Not a zero-latency IRQ: the handler uses kernel objects.
	 */
	interrupts = <40 0>;
};

/* Keep the unused Arduino UART inactive. */
&uart1 {
	status = "disabled";
};

/*
 * Volume knob on the SAADC: pot wiper -> P0.15 = AIN2.
 *
 * P0.15 is not a choice, it is the last analog pin standing: AIN0-7 are
 * fixed in silicon to P0.13-P0.20, and of those P0.13 clocks the microSD
 * SPI, P0.14/P0.16 are the PWM audio clocks and P0.17-P0.20 are the I2S
 * bus. Channel setup (VDD/4 reference + 1/4 gain, so the reading is
 * ratiometric to the same rail the pot spans and rail sag cancels) lives
 * in main.c, not in a DT child node.
 *
 * DK caveat: P0.15 sits in the VCOM2 flow-control group the interface
 * MCU routes by default. If the knob ever reads pinned-high garbage,
 * the IMCU is driving its side of that line — reflash the board
 * controller (nrf9160dk/nrf52840) with vcom2_pins_routing disabled, and
 * never open the host's VCOM2 port with hardware flow control on.
 */
&adc {
	status = "okay";
};

/*
 * I2C2 on the Arduino I2C header: SDA -> P0.30, SCL -> P0.31 (the
 * board's default i2c2 pinctrl). The DK routes no pull-ups to these
 * pins — the bus needs external 4.7 k resistors to 3V on the breadboard
 * (see firmware/CONTROLS_WIRING.md).
 *
 * Two breakouts share the bus, both probed raw (no child nodes, no
 * Zephyr sensor drivers — the register recipes are a handful of writes
 * and the sensor subsystem would cost kilobytes this build does not
 * have):
 *
 *   0x5A  DRV2605L haptic driver (LRA)  — haptic.c
 *   0x6A  LSM6DSOX accelerometer        — accel_tap.c (0x6B if the
 *         breakout's DO/SDO jumper is high)
 *
 * Either breakout may be physically absent; each module probes its
 * address exactly once at boot and degrades (haptics -> LED patterns,
 * double-tap wake -> buttons only), so an absent part costs one boot
 * log line.  100 kHz for the same reason the SD bus runs slow: loose
 * breadboard wiring.
 */
&i2c2 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;
};

/*
 * Adafruit microSD breakout #254 on the Arduino SPI header:
 *   CLK -> D13 / P0.13, DO -> D12 / P0.12, DI -> D11 / P0.11,
 *   CS -> D10 / P0.10.
 */
&arduino_spi {
	status = "okay";

	sd_slot: sdhc@0 {
		compatible = "zephyr,sdhc-spi-slot";
		reg = <0>;
		/* Conservative speed for loose breadboard wiring. */
		spi-max-frequency = <2000000>;
		status = "okay";

		sdmmc {
			compatible = "zephyr,sdmmc-disk";
			disk-name = "SD";
			status = "okay";
		};
	};
};
