#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>
#include <samples/cellular/nrf91_crypto_partitions.dtsi>

/*
 * Breadboard hardware controls (owner's 2026-08-12 parts order).
 *
 * All buttons and the encoder switch to GND and rely on the internal
 * pull-ups declared here, so a wire that falls off the breadboard reads
 * "not pressed" instead of chattering. The mic-power sense is the one
 * deliberate exception: it watches the SPH0645's VDD net through 100k,
 * so it must not fight that net with any pull at all — high means the
 * red latching switch is feeding the mic, low means the owner cut its
 * power (the only honest hardware mute a digital mic has).
 */
/ {
	pendant_controls {
		compatible = "gpio-keys";

		ask_button: ask_button {
			gpios = <&gpio0 21 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		};
		memo_button: memo_button {
			gpios = <&gpio0 22 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		};
		/*
		 * Blue button, remapped 2026-08-12 from approve/deny to
		 * PUSH-TO-TALK (press = record a question with the radio off,
		 * press again = upload it and play the spoken answer). The pin,
		 * the pull policy and the sense-edge bit are unchanged — only
		 * what the firmware does with the edge changed.
		 */
		ptt_button: ptt_button {
			gpios = <&gpio0 23 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		};
		/*
		 * THREE WIRES, NOT FIVE. Owner's ruling 2026-08-12: "we're not
		 * going to use the button on the rotary encoder." Their part is
		 * the illuminated type (3 rotation pins + 5 pins carrying a
		 * switch and a built-in LED); only rotation is wired — A -> P0.24,
		 * C -> GND, B -> P0.25. There is no encoder_push node because
		 * P0.28 IS NOT CONNECTED: declaring it would arm an interrupt on
		 * a floating pin. Select is now the firmware's dwell timer
		 * (MENU_DWELL_MS in src/main.c). **P0.28 is free** — first claim
		 * on the next feature that needs a GPIO.
		 */
		encoder_a: encoder_a {
			gpios = <&gpio0 24 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		};
		encoder_b: encoder_b {
			gpios = <&gpio0 25 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		};
		mic_power_sense: mic_power_sense {
			gpios = <&gpio0 26 GPIO_ACTIVE_HIGH>;
		};
	};

	/*
	 * Output-only pins share the gpio-leds shape (plain DT gpios consumed
	 * through GPIO_DT_SPEC_GET; no LED driver is enabled, so no code cost).
	 *
	 * amp_sd_mode gates the MAX98357A speaker amp: driven HIGH the amp
	 * plays the LEFT I2S slot (SD_MODE > 1.4 V = left channel, datasheet
	 * Table 5), which is the only slot this firmware ever puts audio in;
	 * driven LOW the amp is in full shutdown (0.6 uA). Boot default is
	 * LOW — Bluetooth through the ESP32 stays the sink until an
	 * {"type":"audio_sink"} control frame says otherwise.
	 *
	 * P0.01 because it is the last direction-safe free pin: it is the
	 * nRF91-TX line of the (disabled) uart1/VCOM2 group, so the DK's
	 * interface MCU only ever LISTENS on it. P0.00 (the group's RX) is
	 * driven by the interface MCU and P0.15 is the volume pot's ADC
	 * input (the only free AIN — see &adc below). Someone opening VCOM2
	 * on the host sees sink toggles as stray bytes; nothing more.
	 */
	pendant_outputs {
		compatible = "gpio-leds";

		amp_sd_mode: amp_sd_mode {
			gpios = <&gpio0 1 GPIO_ACTIVE_HIGH>;
		};
	};

	/*
	 * RGB status indicator (plain 4-leg part, one common leg + R/G/B,
	 * each colour leg through ~330 ohm).  Driven by PWM0 channels 0-2
	 * from src/pendant_status.c through the raw nrfx HAL, exactly the
	 * way main.c drives PWM1/PWM2 for the microphone clocks — no Zephyr
	 * PWM driver, no LED driver, no runtime device.
	 *
	 * These nodes exist so the PIN CLAIM is visible here with every other
	 * claim on this board; the code reads them with DT_GPIO_PIN(), which
	 * is a compile-time constant, so declaring them costs nothing.  The
	 * ACTIVE_HIGH flags describe the common-cathode default; the
	 * common-anode case is one inverted PWM duty bit and lives behind
	 * CONFIG_PENDANT_RGB_COMMON_ANODE, not behind a devicetree edit.
	 *
	 * P0.03 and P0.04 are the DK's LED2 and LED3 pins and P0.07 is the
	 * DK's Button 2 pin; boards/nrf9160dk_nrf52840.overlay opens all
	 * three analog switches, the same move the Bluetooth UART made for
	 * LED4.  THE TRADEOFF, stated: the DK's on-board Button 2 is gone.
	 * Acceptable — this firmware's buttons are the external yellow,
	 * green and blue ones on P0.21-P0.23, and Button 2's only firmware
	 * job (the bookmark press) is reachable from those.
	 */
	pendant_status_rgb {
		compatible = "gpio-leds";

		rgb_red: rgb_red {
			gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>;
		};
		rgb_green: rgb_green {
			gpios = <&gpio0 4 GPIO_ACTIVE_HIGH>;
		};
		rgb_blue: rgb_blue {
			gpios = <&gpio0 7 GPIO_ACTIVE_HIGH>;
		};
	};

	aliases {
		rgb-red = &rgb_red;
		rgb-green = &rgb_green;
		rgb-blue = &rgb_blue;
		ask-btn = &ask_button;
		memo-btn = &memo_button;
		ptt-btn = &ptt_button;
		encoder-a = &encoder_a;
		encoder-b = &encoder_b;
		mic-sense = &mic_power_sense;
		amp-sd-mode = &amp_sd_mode;
	};
};

/*
 * The board nodes that used to own the three RGB pins, retired here so that
 * no future CONFIG_LED / CONFIG_INPUT can quietly re-claim them behind the
 * status subsystem's back.  Neither driver is enabled in this build today —
 * this is the seatbelt, not the brake.
 *
 *   led1    P0.03 -> RGB red
 *   led2    P0.04 -> RGB green
 *   button1 P0.07 -> RGB blue  (the DK's Button 2)
 */
&led1 {
	status = "disabled";
};

&led2 {
	status = "disabled";
};

&button1 {
	status = "disabled";
};

/*
 * PWM0 belongs to src/pendant_status.c through the raw nrfx HAL, so its
 * devicetree instance is disabled — the same arrangement PWM1/PWM2 already
 * have for the microphone clocks (they are disabled in devicetree and driven
 * by main.c).  Disabled here means "no Zephyr driver may bind", not "the
 * peripheral is unused": a bound pwm_nrfx would apply pwm0_default, which
 * puts PWM_OUT0 on P0.02 — this firmware's one on-board status LED.
 *
 * pwm_led0 goes with it: it is the board's demo node for that same channel.
 */
&pwm0 {
	status = "disabled";
};

&pwm_led0 {
	status = "disabled";
};

/*
 * Edge interrupts for the new controls ride the GPIO SENSE mechanism
 * (PORT event) instead of GPIOTE channels: the nRF9160 has only 8 GPIOTE
 * channels and the DK's own buttons already use some. Encoder edges are
 * hand-speed (worst observed ~2.5 ms apart on a fast spin) — µs-class
 * PORT latency is irrelevant there. Bits: P0.21-25.
 *
 * P0.28's bit is GONE (0x1be00000 -> 0x0be00000) with the encoder push: an
 * unwired pin left in the sense mask is a floating input free to wake the
 * CPU on every breadboard-coupled edge, which is a battery leak that looks
 * like a firmware bug.
 *
 * P0.27's bit is GONE too (0x0be00000 -> 0x03e00000) with the accelerometer:
 * the owner is not using it anymore, so the pin is unclaimed and, same rule
 * as P0.28, must not be left armed in the sense mask.
 */
&gpio0 {
	sense-edge-mask = <0x03e00000>;
};

/*
 * Console goes TX-only on its board-default pin (P0.29 -> DK VCOM0).
 *
 * The board's uart0_default pinctrl also claimed P0.26 (CTS, with a
 * bias-pull-up — directly against the mic-sense contract above, which
 * requires NO pull on that net), P0.27 (RTS — held the accelerometer's
 * INT1, now unclaimed by anything) and P0.28 (RX — once the encoder push,
 * likewise unclaimed). Nothing ever used them: flow control was never
 * enabled and console input is not a thing this firmware has. Dropping
 * them from the pinctrl frees all three pins honestly instead of leaning
 * on "the UARTE probably won't drive them" — and P0.27/P0.28 stay free,
 * so this repin is what keeps them genuinely available rather than
 * merely unused.
 */
&pinctrl {
	uart0_console_txonly: uart0_console_txonly {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 29)>;
		};
	};

	uart0_sleep_txonly: uart0_sleep_txonly {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 29)>;
			low-power-enable;
		};
	};
};

&uart0 {
	pinctrl-0 = <&uart0_console_txonly>;
	pinctrl-1 = <&uart0_sleep_txonly>;
	disable-rx;
};

/*
 * SRAM partitions — same node structure as Nordic's
 * nrf91_sram_crypto_partitions.dtsi but sized for THIS build: that dtsi
 * reserves 88 kB of secure RAM for the full TF-M crypto profile, while
 * this firmware runs TFM_PROFILE_TYPE_MINIMAL (32 kB). The 56 kB
 * difference funds the full-duplex audio buffers (concurrent Opus
 * encoder + decoder + jitter ring).
 *
 *   0x2000_0000  Secure RAM (TF-M minimal)       (   32 kB)
 *   0x2000_8000  Non-secure RAM area             (  224 kB)
 *     0x2000_8000  Modem shared area             ( 17768 B)
 *       0x2000_8000  control                     (  1256 B)
 *       0x2000_84e8  app -> cell                 (  8320 B)
 *       0x2000_a568  cell -> app                 (    8 kB)
 *     0x2000_c568  Application RAM               (211608 B)
 */
/delete-node/ &sram0_s;
/delete-node/ &sram0_ns;

&sram0 {
	sram0_s: sram@0 {
		reg = <0x0 0x8000>;
	};

	sram0_ns: sram@8000 {
		reg = <0x8000 0x38000>;
		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0x0 0x8000 0x38000>;

		/* Must be in first 128 kB of RAM. */
		sram0_ns_modem: sram0_ns@0 {
			/* Modem (shared) memory */
			reg = <0x0 0x4568>;
			#address-cells = <1>;
			#size-cells = <1>;
			ranges = <0x0 0x0 0x4568>;

			cpuapp_cpucell_ipc_shm_ctrl: sram0_ns_modem@0 {
				/* Modem IPC control */
				reg = <0x0 0x4e8>;
			};

			cpuapp_cpucell_ipc_shm_heap: sram0_ns_modem@4e8 {
				/* Modem IPC transmit */
				reg = <0x4e8 0x2080>;
			};

			cpucell_cpuapp_ipc_shm_heap: sram0_ns_modem@2568 {
				/* Modem IPC receive */
				reg = <0x2568 0x2000>;
			};
		};

		sram0_ns_app: sram0_ns@4568 {
			/* Non-Secure application memory */
			reg = <0x4568 0x33a98>;
		};
	};
};

&pinctrl {
	/*
	 * Agent-response audio to the ESP32 Bluetooth bridge:
	 *   LRC  -> A3 / P0.17 -> ESP32 GPIO33
	 *   BCLK -> A4 / P0.18 -> ESP32 GPIO27
	 *   DATA -> A5 / P0.19 -> ESP32 GPIO14
	 *
	 * Unlike the former A0/A1 pins, P0.17/P0.18/P0.19 are routed directly
	 * to the Arduino header and are not shared with the DK's VCOM2 path.
	 */
	/*
	 * The Adafruit SPH0645LM4H I2S microphone shares this bus:
	 *   DOUT -> dedicated GPIO header / P0.20 (I2S SDIN)
	 *
	 * During recording the nRF9160 runs I2S in slave mode: the SPH0645
	 * requires exactly 64 BCLK per stereo frame, which this I2S
	 * peripheral cannot generate as master (24-bit max word = 48 BCLK).
	 * PWM1/PWM2 generate BCLK on P0.16 (A2) and LRCLK on P0.14 (A0);
	 * two breadboard jumpers feed them back into P0.18 and P0.17.
	 * During playback the peripheral is master and drives the same pins.
	 */
	/*
	 * SDIN sits in its own group so it can carry a pull-down: with the
	 * red latching switch cutting the SPH0645's power, its DOUT floats,
	 * and an undriven SDIN would feed the capture path random full-scale
	 * garbage. The ~13k internal pull-down turns a depowered mic into
	 * digital silence. While the mic IS powered it drives DOUT only in
	 * the left slot and tri-states the rest of the frame — the pull-down
	 * resolves those tri-stated cycles to 0, exactly as before.
	 */
	i2s0_default_agent_audio: i2s0_default_agent_audio {
		group1 {
			psels = <NRF_PSEL(I2S_LRCK_M, 0, 17)>,
				<NRF_PSEL(I2S_SCK_M, 0, 18)>,
				<NRF_PSEL(I2S_SDOUT, 0, 19)>;
		};
		group2 {
			psels = <NRF_PSEL(I2S_SDIN, 0, 20)>;
			bias-pull-down;
		};
	};

	i2s0_sleep_agent_audio: i2s0_sleep_agent_audio {
		group1 {
			psels = <NRF_PSEL(I2S_LRCK_M, 0, 17)>,
				<NRF_PSEL(I2S_SCK_M, 0, 18)>,
				<NRF_PSEL(I2S_SDOUT, 0, 19)>;
			low-power-enable;
		};
		group2 {
			psels = <NRF_PSEL(I2S_SDIN, 0, 20)>;
			bias-pull-down;
			low-power-enable;
		};
	};
};

/*
 * One I2S peripheral serves both audio directions, never at the same time:
 * slave RX from the SPH0645 microphone while recording, master TX to the
 * ESP32 Bluetooth bridge while playing the agent reply.
 */
&i2s0 {
	status = "okay";
	pinctrl-0 = <&i2s0_default_agent_audio>;
	pinctrl-1 = <&i2s0_sleep_agent_audio>;
	pinctrl-names = "default", "sleep";
	clock-source = "PCLK32M";
	/*
	 * Priority 0, above NRF_DEFAULT_IRQ_PRIORITY (1). The modem's IPC
	 * IRQ and RTC1 also sit at 1, so at the default the I2S ISR could
	 * never preempt modem processing — and missing the I2S buffer
	 * deadline by one block period kills the whole duplex transfer.
	 * Not a zero-latency IRQ: the handler uses kernel objects.
	 */
	interrupts = <40 0>;
};

/*
 * ---- Bluetooth-module command link (uart1, 115200 8N1) ----
 *
 * The ESP32 stands in for a BM83-class Bluetooth audio module, and a module
 * like that is commanded over exactly one thing: a UART. So the nRF9160 owns
 * a UART to it, and the ESP32's USB port stays a debug console.
 *
 *   nRF P0.00 (TX) -> ESP32 GPIO16 (RX2)
 *   nRF P0.05 (RX) <- ESP32 GPIO17 (TX2)
 *
 * PIN VERDICT, resolved honestly against everything already claimed here:
 *
 *   TX = P0.00. It is uart1's board-default RX pin and part of the DK's
 *   VCOM2 group (P0.00/P0.01/P0.14/P0.15), where the interface MCU is the
 *   driver — which would be a hard conflict with an output, EXCEPT that
 *   this project already ships boards/nrf9160dk_nrf52840.overlay with
 *   vcom2_pins_routing DISABLED, so the analog switch between the IMCU and
 *   these four pins is open. P0.01 (the group's other line) has been
 *   driving MAX98357A SD_MODE on that same basis for weeks. Flashing the
 *   stock board-controller image would put the IMCU back on P0.00 and this
 *   TX would fight it — the board-controller overlay is a hard dependency
 *   of this pin, not a nicety.
 *
 *   RX = P0.05, the DK's LED4 pin. Every other candidate was taken when this
 *   was chosen: P0.01 = SD_MODE, P0.29 = console TX, P0.26 = mic sense
 *   (P0.27 held the accelerometer's INT1 then and is free now; P0.28 held
 *   the encoder push then and is free now — see the encoder node),
 *   P0.15 = the volume ADC, P0.10-13 =
 *   microSD, P0.14/16-20 = the audio bus, P0.21-25 = buttons and encoder,
 *   P0.30/31 = I2C. Of the four LED pins P0.02 is led0 (this firmware's
 *   only status LED) and P0.03/P0.04 are the next two; taking the HIGHEST
 *   unused one leaves the low LEDs available if a future build wants a
 *   second indicator. The same board-controller overlay now also disables
 *   led4_pin_routing, so the on-board LED4 is switched away from the pin
 *   and P0.05 is a clean input.
 *
 *   THE TRADEOFF, stated: DK LED4 is gone. With the stock board-controller
 *   image (LED4 still routed) the link still runs — 115200 has 8.7 us per
 *   bit against an LED network that only loads the line by a few mA — but
 *   LED4 glows on the idle-high line, and with the ESP32 unpowered the LED
 *   string pulls RX low, which the UARTE reports as a break. No ESP32, no
 *   commands: an honest failure.
 *
 * No hardware flow control: two wires, and the command set is short
 * newline-delimited JSON with no burst that can outrun a 115200 receiver.
 */
&pinctrl {
	uart1_bt_module: uart1_bt_module {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 0)>;
		};

		group2 {
			psels = <NRF_PSEL(UART_RX, 0, 5)>;
			/*
			 * Pull-up on RX only: with the module unpowered or its
			 * wire off, an undriven RX floats and the UARTE turns
			 * noise into framing errors forever. Idle-high is the
			 * UART's own "nothing to say".
			 */
			bias-pull-up;
		};
	};

	uart1_bt_module_sleep: uart1_bt_module_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 0)>;
		};

		group2 {
			psels = <NRF_PSEL(UART_RX, 0, 5)>;
			bias-pull-up;
			low-power-enable;
		};
	};
};

&uart1 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart1_bt_module>;
	pinctrl-1 = <&uart1_bt_module_sleep>;
	pinctrl-names = "default", "sleep";
};

/*
 * Volume knob on the SAADC: pot wiper -> P0.15 = AIN2.
 *
 * P0.15 is not a choice, it is the last analog pin standing: AIN0-7 are
 * fixed in silicon to P0.13-P0.20, and of those P0.13 clocks the microSD
 * SPI, P0.14/P0.16 are the PWM audio clocks and P0.17-P0.20 are the I2S
 * bus. Channel setup (VDD/4 reference + 1/4 gain, so the reading is
 * ratiometric to the same rail the pot spans and rail sag cancels) lives
 * in main.c, not in a DT child node.
 *
 * DK caveat: P0.15 sits in the VCOM2 flow-control group the interface
 * MCU routes by default. If the knob ever reads pinned-high garbage,
 * the IMCU is driving its side of that line — reflash the board
 * controller (nrf9160dk/nrf52840) with vcom2_pins_routing disabled, and
 * never open the host's VCOM2 port with hardware flow control on.
 */
&adc {
	status = "okay";
};

/*
 * I2C2 on the Arduino I2C header: SDA -> P0.30, SCL -> P0.31 (the
 * board's default i2c2 pinctrl). The DK routes no pull-ups to these
 * pins — the bus needs external 4.7 k resistors to 3V on the breadboard
 * (see firmware/CONTROLS_WIRING.md).
 *
 * One breakout lives on the bus, probed raw (no child node, no Zephyr
 * sensor driver — the register recipe is a handful of writes and the
 * sensor subsystem would cost kilobytes this build does not have):
 *
 *   0x5A  DRV2605L haptic driver (LRA)  — haptic.c
 *
 * The breakout may be physically absent; it probes its address exactly
 * once at boot and degrades (haptics -> LED patterns), so an absent
 * part costs one boot log line.  100 kHz for the same reason the SD
 * bus runs slow: loose breadboard wiring.
 */
&i2c2 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;
};

/*
 * Adafruit microSD breakout #254 on the Arduino SPI header:
 *   CLK -> D13 / P0.13, DO -> D12 / P0.12, DI -> D11 / P0.11,
 *   CS -> D10 / P0.10.
 */
&arduino_spi {
	status = "okay";

	sd_slot: sdhc@0 {
		compatible = "zephyr,sdhc-spi-slot";
		reg = <0>;
		/* Conservative speed for loose breadboard wiring. */
		spi-max-frequency = <2000000>;
		status = "okay";

		sdmmc {
			compatible = "zephyr,sdmmc-disk";
			disk-name = "SD";
			status = "okay";
		};
	};
};
