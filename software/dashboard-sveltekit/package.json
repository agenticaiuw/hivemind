{
  "name": "ai-pendant-dashboard-sveltekit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite dev",
    "build": "vite build",
    "build:agent": "DASHBOARD_TARGET=agent VITE_DASHBOARD_BACKEND=agent vite build",
    "preview": "vite preview",
    "deploy:cloudflare": "npm run build && wrangler deploy --env=\"\"",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@sveltejs/adapter-static": "^3.0.10"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "7.2.9",
    "@sveltejs/kit": "2.70.2",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.19.19",
    "svelte": "5.56.8",
    "svelte-check": "4.3.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.0",
    "wrangler": "4.118.0"
  }
}
