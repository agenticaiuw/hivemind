# =============================================================================
# AI Pendant — ONE env file (copy to ai-pendant.env and fill in)
# =============================================================================

# Shared login + one-time device pairing (dashboard "pairing code" uses this)
PAIRING_CODE=replace-with-a-random-code

# Relay / bridge / dashboard server auth
RELAY_API_KEY=replace-with-a-random-relay-key

# Mac local agent (localhost Bearer token)
AGENT_TOKEN=replace-with-a-random-agent-token

# OpenRouter API key (planning + multimodal audio)
OPENROUTER_API_KEY=sk-or-v1-...

# Cloudflare Worker URL for the relay
RELAY_URL=https://your-relay.workers.dev

# Dashboard session cookie HMAC secret (≥32 chars)
SESSION_SECRET=replace-with-a-long-random-secret

# --- optional (defaults in code; set only to override) ---
# LLM_MODEL=deepseek/deepseek-v4-flash-0731
# LLM_VISION_MODEL=google/gemini-3.6-flash
# LLM_AUDIO_MODEL=google/gemini-3.6-flash
# FULL_CONTROL_MODE=true
# MAC_AGENT_PORT=8000
