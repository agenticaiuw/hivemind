{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-gadget.local/schemas/device-agent-report.v1.schema.json",
  "title": "Device Agent Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "accountId",
    "deviceId",
    "agentId",
    "sequence",
    "generatedAt",
    "expiresAt",
    "device",
    "status",
    "capabilities"
  ],
  "properties": {
    "schemaVersion": {
      "const": "device-agent-report.v1"
    },
    "accountId": {
      "$ref": "#/$defs/id"
    },
    "deviceId": {
      "$ref": "#/$defs/id"
    },
    "agentId": {
      "$ref": "#/$defs/id"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "enum": [
            "pendant",
            "mac",
            "ios",
            "browser_extension",
            "web"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "platform": {
          "type": "string",
          "maxLength": 160
        },
        "osVersion": {
          "type": "string",
          "maxLength": 80
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 160
        },
        "version": {
          "type": "string",
          "maxLength": 80
        },
        "build": {
          "type": "string",
          "maxLength": 160
        }
      }
    },
    "status": {
      "enum": [
        "online",
        "degraded",
        "offline",
        "unknown"
      ]
    },
    "capabilities": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "logAccess": {
          "enum": [
            "local_only",
            "redacted_cloud",
            "unavailable"
          ]
        },
        "healthEndpoint": {
          "type": "string",
          "maxLength": 2048
        },
        "logHint": {
          "type": "string",
          "maxLength": 500
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilityId",
        "availability",
        "permission",
        "scope"
      ],
      "properties": {
        "capabilityId": {
          "$ref": "#/$defs/id"
        },
        "availability": {
          "enum": [
            "available",
            "degraded",
            "unavailable",
            "unknown"
          ]
        },
        "permission": {
          "enum": [
            "granted",
            "denied",
            "prompt",
            "not_applicable",
            "unknown"
          ]
        },
        "scope": {
          "enum": [
            "device",
            "agent",
            "browser",
            "app"
          ]
        },
        "detail": {
          "type": "string",
          "maxLength": 500
        },
        "checkedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
