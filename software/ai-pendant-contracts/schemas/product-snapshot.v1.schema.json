{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-gadget.local/schemas/product-snapshot.v1.schema.json",
  "title": "Product Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "accountId",
    "revision",
    "generatedAt",
    "devices",
    "sessions",
    "runs"
  ],
  "properties": {
    "schemaVersion": {
      "const": "product-snapshot.v1"
    },
    "accountId": {
      "$ref": "#/$defs/id"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "devices": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/device"
      }
    },
    "sessions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/session"
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/run"
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "updatedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deviceId",
        "kind",
        "name",
        "status",
        "lastSeenAt"
      ],
      "properties": {
        "deviceId": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "pendant",
            "mac",
            "ios",
            "browser_extension",
            "web"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "status": {
          "enum": [
            "online",
            "degraded",
            "offline",
            "unknown"
          ]
        },
        "lastSeenAt": {
          "type": "string",
          "format": "date-time"
        },
        "capabilitiesRevision": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionId",
        "title",
        "createdAt",
        "updatedAt",
        "turnCount"
      ],
      "properties": {
        "sessionId": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastTurnAt": {
          "type": "string",
          "format": "date-time"
        },
        "turnCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "sourceDeviceId",
        "status",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "runId": {
          "$ref": "#/$defs/id"
        },
        "sessionId": {
          "oneOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceDeviceId": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "enum": [
            "queued",
            "processing",
            "waiting_for_device",
            "completed",
            "failed",
            "cancelled"
          ]
        },
        "command": {
          "type": "string",
          "maxLength": 10000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
