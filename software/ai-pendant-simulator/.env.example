# =============================================================================
# REQUIRED (minimum to run the Mac agent + talk to the cloud relay)
# =============================================================================
# Agent token: authenticates the local Mac agent HTTP API (localhost only).
# Pairing code: one-time code used when a *new* device (Mac bridge / phone app)
# registers with the relay. After registration, devices use RELAY_API_KEY /
# device credentials — not the pairing code — on every request.
AGENT_TOKEN=replace-with-a-random-shared-token
PAIRING_CODE=replace-with-a-shared-pairing-code
RELAY_API_KEY=replace-with-a-random-relay-api-key
RELAY_URL=http://localhost:8787
LLM_API_KEY=sk-or-v1-your-openrouter-key

# =============================================================================
# USUALLY FINE AS DEFAULTS (change only if ports collide or you deploy)
# =============================================================================
MAC_AGENT_PORT=8000
RELAY_PORT=8787
VITE_RELAY_URL=http://localhost:8787
BRIDGE_DEVICE_ID=home-macbook-bridge
LOCAL_AGENT_URL=http://127.0.0.1:8000

# Full computer control (default: true). Set false to restore whitelist-only demo mode.
FULL_CONTROL_MODE=true
VITE_FULL_CONTROL_MODE=true

# LLM via OpenRouter (recommended for switching models easily)
LLM_ENABLED=true
LLM_API_KEY=sk-or-v1-your-openrouter-key
LLM_API_BASE_URL=https://openrouter.ai/api/v1
# OpenRouter slug for DeepSeek V4 Flash (fast agentic reasoning + tool use)
LLM_MODEL=deepseek/deepseek-v4-flash-0731
# Screenshots go here instead; DeepSeek is text-only and rejects images.
LLM_VISION_MODEL=google/gemini-3.6-flash
# auto | low | medium | high | off — auto spends thinking time only on retries
# and on commands whose wording implies multiple dependent steps.
LLM_REASONING_EFFORT=auto
LLM_MAX_TOKENS=1024
STT_MODEL=openai/whisper-large-v3
# Multimodal audio→transcript+plan pilot on the cloud relay. Uses OpenRouter
# chat completions with input_audio. Falls back to STT_MODEL on failure.
LLM_AUDIO_MODEL=google/gemini-3.6-flash
# Set to 0 or false to skip the audio-native planner and always use Whisper STT.
AUDIO_NATIVE_PLANNER=true
TTS_MODEL=x-ai/grok-voice-tts-1.0
TTS_VOICE=eve
OPENROUTER_HTTP_REFERER=https://github.com/geunwoo-dev/ai-pendant-simulator
OPENROUTER_APP_TITLE=AI Pendant Simulator
# Optional local paths. Defaults are the checked-out repository and
# ~/AI-Pendant-Workspace, so these normally do not need to be set.
PENDANT_PROJECT_PATH=
PENDANT_WORKSPACE_PATH=

# --- Computer use (mouse, keyboard, screen) -------------------------------
# The perceive-act loop is opt-in even though FULL_CONTROL_MODE defaults on:
# driving the screen is a different capability from running a planned action.
PENDANT_COMPUTER_USE_ENABLED=0
# Screenshots are uploaded to LLM_API_BASE_URL (a third-party inference
# provider) and to whatever upstream model it routes to. That is a materially
# different privacy posture from the text-only agent, so it needs its own
# explicit consent.
PENDANT_VISION_UPLOAD_CONSENT=0
# Hard ceilings the loop can never be asked to exceed.
PENDANT_MAX_STEPS=25
PENDANT_MAX_BUDGET_MS=180000
# Apps whose windows are never captured. Empty falls back to the built-in list
# (1Password, Keychain Access, Passwords, Bitwarden, System Settings, Messages, Mail).
# PENDANT_SCREENSHOT_DENY_APPS=1Password,Keychain Access
# Screenshots are ephemeral by default: 0700 temp dir, 30 minute TTL, last 20
# per session, whole directory removed when the loop ends and on agent start.
PENDANT_SCREENSHOT_TTL_MS=1800000
PENDANT_SCREENSHOT_KEEP=20
# PENDANT_KEEP_SCREENSHOTS=1
# Print the CGEvent that would be posted and exit, without moving the cursor.
# The single most useful way to exercise the real stack on a real Mac safely.
# PENDANT_INPUT_DRYRUN=1

# --- Relay audio retention -------------------------------------------------
# Voice recordings are the owner's private audio and are exempt from the 24h
# relay queue cleanup, so they get their own window. Default 30 days. A blank,
# zero, or negative value falls back to the default on purpose: an accidental
# 0 must never mean "erase everything".
AUDIO_RETENTION_MAX_AGE_MS=2592000000
# A retention sweep deletes nothing unless this is true AND the request passes
# {"dryRun": false}. Deleting one run's recording on demand
# (DELETE /v1/ops/history/:pipelineId/audio) does not need this flag.
AUDIO_RETENTION_SWEEP_ENABLED=false
