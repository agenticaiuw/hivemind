{
  "name": "ai-pendant-simulator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host 0.0.0.0",
    "dev:ops": "vite --open /dashboard.html",
    "agent": "node local-agent/server.js",
    "agent:install": "node local-agent/macos/setupPermissions.js --install-only",
    "agent:setup": "node local-agent/macos/setupPermissions.js",
    "agent:autostart": "node local-agent/macos/setupPermissions.js --autostart",
    "agent:logs": "tail -n 200 -F \"$HOME/Library/Logs/AIPendant/agent.out.log\" \"$HOME/Library/Logs/AIPendant/agent.err.log\"",
    "bridge": "node local-agent/runBridge.js",
    "relay": "node cloud-relay/server.js",
    "relay:cloudflare:dev": "npx wrangler dev",
    "relay:cloudflare:deploy": "npx wrangler deploy",
    "remote:stack": "npm run relay & npm run agent & npm run bridge",
    "start": "node local-agent/server.js",
    "build": "vite build",
    "dashboard": "npm run build && node local-agent/server.js",
    "ops": "node -e \"import('node:child_process').then(({spawn})=>spawn('open',['http://localhost:8000/dashboard'],{stdio:'inherit'}))\"",
    "build:ios": "node scripts/build-ios-web.mjs",
    "ios": "npm run ios:sync && npx cap open ios",
    "ios:sync": "npm run build:ios && npx cap sync ios",
    "ios:archive": "bash scripts/archive-ios.sh",
    "ios:testflight": "PENDANT_UPLOAD_TESTFLIGHT=1 bash scripts/archive-ios.sh",
    "inspect:workflow": "node scripts/inspect-pendant-workflow.mjs",
    "inspect:audio": "node scripts/capture-pendant-audio.mjs",
    "test": "node --test --test-concurrency=1",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/status-bar": "^8.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "opusscript": "^0.1.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "^1.0.3"
  }
}
