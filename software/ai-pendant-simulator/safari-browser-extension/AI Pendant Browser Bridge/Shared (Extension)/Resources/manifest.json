{
  "manifest_version": 3,
  "name": "AI Pendant Browser Bridge",
  "version": "1.7.9",
  "description": "Lets your local AI Pendant agent control explicitly permitted browser tabs on this Mac.",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "512": "icons/icon-512.png"
  },
  "permissions": [
    "alarms",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://ai-pendant-relay.evan20050827.workers.dev/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "type": "module",
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "AI Pendant Browser Bridge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  }
}
