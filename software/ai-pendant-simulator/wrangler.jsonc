{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-pendant-relay",
  // opusscript asm.js probes __dirname in its Node branch; Workers ESM has none.
  "define": { "__dirname": "'/opusscript'" },
  "workers_dev": true,
  "main": "cloudflare-worker/worker.js",
  // NOTE: on Workers Paid, set "limits": { "cpu_ms": 300000 } here — a
  // full-duplex conversation holds one WS invocation for minutes of wasm
  // transcode. The Free plan rejects the limits key entirely (deploy error
  // 100328); today's transcode load runs under Free's enforcement, but if
  // long conversations die with CPU errors, upgrading is the fix.
  "compatibility_date": "2026-07-31",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "RELAY_PORT": "8787",
    // 20s window × 500ms claim spacing ≈ 40 D1 subrequests per empty poll —
    // safely under Cloudflare's per-request subrequest cap. The previous
    // 25s × 25ms spacing (~1000 subrequests) tripped the cap and made
    // Cloudflare kill the poll with an HTML 503, which drove the Mac bridge
    // into its 30s error backoff (the 16-25s job-pickup stalls).
    // Short holds bound the blast radius of a silently-stalled poll (stale
    // keep-alive socket, event-loop stall) to one 5s window instead of 20-30s.
    // 5s × 250ms spacing ≈ 20 D1 claims per empty poll — far under limits.
    "BRIDGE_POLL_TIMEOUT_MS": "5000",
    "BRIDGE_CLAIM_MIN_INTERVAL_MS": "250",
    "JOB_TTL_MS": "86400000",
    "AUDIO_BUCKET_PREFIX": "audio-captures",
    // Private voice recordings survive the 24h queue cleanup, so they carry
    // their own window: 30 days. Sweeps stay off until deliberately enabled.
    "AUDIO_RETENTION_MAX_AGE_MS": "2592000000",
    "AUDIO_RETENTION_SWEEP_ENABLED": "false"
  },
  "r2_buckets": [
    {
      "binding": "AUDIO_BUCKET",
      "bucket_name": "ai-pendant-audio"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  // Cloudflare Browser Run — the relay's own headless browser, so public web
  // pages can be read while the Mac is asleep (cloud-relay/serverBrowser.js).
  // The binding, unlike the REST API, needs no token inside the Worker;
  // .quickAction() wants compatibility_date >= 2026-03-24, satisfied above.
  // Free plan reality: 10 browser-minutes a day and one Quick Action every
  // 10s (Paid: unmetered, 10/s). serverBrowser.js reports the 429 wait rather
  // than stalling a voice turn on it.
  "browser": {
    "binding": "BROWSER"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-pendant-relay-db",
      "database_id": "6addfd88-af2d-4027-aedc-12a1aad694b0"
    }
  ],
  // The bridge doorbell (cloudflare-worker/bridgeHub.js): one instance per
  // Mac bridge, named by deviceId. Holds the Mac's idle WebSocket via the
  // Hibernation API, so a connected-but-quiet Mac accrues no DO duration and
  // heartbeat pings are auto-answered without ever waking the object. Job
  // payloads NEVER travel through it — it only tells the bridge to run its
  // normal authenticated D1 claim immediately instead of on the next safety
  // poll. Free-plan notes: DO classes must be SQLite-backed (hence
  // new_sqlite_classes below — new_classes would be rejected at deploy), and
  // each doorbell ring is one DO request + one Worker subrequest against the
  // shared 100k/day request budget; at this fleet's job volume that is noise.
  "durable_objects": {
    "bindings": [
      {
        "name": "BRIDGE_HUB",
        "class_name": "BridgeHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BridgeHub"]
    }
  ],
  // The relay's clock (cloud-relay/scheduler.js). Routines used to fire only
  // from the Mac's 30 s setInterval, which meant they fired only while the
  // Mac was awake — and the pendant is worn precisely when it is not.
  //
  // Every minute is Cloudflare's finest granularity, and it is the right one:
  // a "7:00 am" promise must not be able to land at 7:04. Cost is 1,440
  // invocations a day against the Free plan's 100,000 requests, and one of
  // the 5 Cron Triggers a Free account may have across all Workers.
  //
  // Durable Object alarms were the alternative and were rejected: the docs
  // give alarms no precision guarantee, so they buy no accuracy over this,
  // while adding a second storage backend beside D1. See the header of
  // cloud-relay/routines.js for where a DO does become necessary.
  //
  // HARD LIMIT that shapes scheduler.js: a cron invocation on Workers Free
  // gets 10 ms of CPU (awaiting I/O is free, wall clock is 15 minutes). The
  // tick is therefore all awaits — no audio, no bulk JSON, nothing heavy
  // imported at module scope.
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
