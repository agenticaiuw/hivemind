# Optional generic container image for the pendant controller UI.
FROM node:22-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm install
COPY index.html vite.config.js ./
COPY public ./public
COPY src ./src

ARG VITE_RELAY_URL
ARG VITE_FULL_CONTROL_MODE=true
ENV VITE_RELAY_URL=$VITE_RELAY_URL \
    VITE_FULL_CONTROL_MODE=$VITE_FULL_CONTROL_MODE

RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY cloud-relay/nginx-ui.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
